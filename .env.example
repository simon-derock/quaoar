# copy to .env and fill in; .env is gitignored and must never be committed

# SerpApi: keys from accounts you are entitled to use, comma separated
SERPAPI_API_KEYS=

# Cohere: comma separated keys rotate on rate limits; one model is locked for a whole scan
COHERE_API_KEYS=
COHERE_MODEL=command-a-plus-05-2026

# shared ledger and cache for every run
QUAOAR_HOME=~/.quaoar
QUAOAR_MAX_CREDITS_PER_SCAN=45
QUAOAR_KEY_RESERVE=5

# public API serves replay fixtures only and holds no keys
QUAOAR_PUBLIC_MODE=replay
QUAOAR_CORS_ORIGIN=

# timing budgets are multiplied by this (CI uses 3)
QUAOAR_PERF_SCALE=1
